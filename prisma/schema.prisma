generator client {
  provider = "prisma-client"
  output   = "../backend/src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TenantStatus {
  ACTIVE
  DISABLED

  @@map("tenant_status")
}

enum UserStatus {
  PENDING
  ACTIVE
  BLOCKED
  DISABLED

  @@map("user_status")
}

/// USER = tenant_user (docs/09.7); ADMIN = admin; SUPER_ADMIN = superadmin.
enum UserRole {
  USER
  ADMIN
  SUPER_ADMIN

  @@map("user_role")
}

model Tenant {
  id            String          @id @default(uuid()) @db.Uuid
  name          String
  displayName   String          @map("display_name")
  status        TenantStatus
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  deactivatedAt DateTime?       @map("deactivated_at") @db.Timestamptz(3)
  users           User[]
  branding        TenantBranding?
  files           StoredFile[]
  supportSessions SupportSession[]
  integrations        Integration[]
  financialCategories FinancialCategory[]
  financialAccounts   FinancialAccount[]
  parties             Party[]
  receivables         Receivable[]
  payables            Payable[]
  costCenters         CostCenter[]
  installmentCostCenterAllocations InstallmentCostCenterAllocation[]
  revenueGoals        RevenueGoal[]
  financialTransactions FinancialTransaction[]
  financialTransfers    FinancialTransfer[]
  financialAccountBalanceSnapshots FinancialAccountBalanceSnapshot[]
  financialInstallmentLifecycleCheckpoints FinancialInstallmentLifecycleCheckpoint[]
  installmentPresenceCheckpoints InstallmentPresenceCheckpoint[]
  syncRuns            SyncRun[]
  syncCursors         IntegrationSyncCursor[]
  aiSettings          AiTenantSettings?
  aiKnowledgeEntries  AiKnowledgeEntry[]
  aiConversations     AiConversation[]
  aiMessages          AiMessage[]
  aiRuns              AiRun[]

  @@unique([name], map: "uq_tenants_name")
  @@map("tenants")
}

/// Overrides visuais por empresa (1:1). Ausência = fallback da plataforma (ADR-046).
model TenantBranding {
  id          String      @id @default(uuid()) @db.Uuid
  tenantId    String      @unique @map("tenant_id") @db.Uuid
  logoFileId  String?     @unique @map("logo_file_id") @db.Uuid
  iconFileId  String?     @unique @map("icon_file_id") @db.Uuid
  lightColors Json?       @map("light_colors")
  darkColors  Json?       @map("dark_colors")
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  logoFile    StoredFile? @relation("TenantBrandingLogo", fields: [logoFileId], references: [id], onDelete: SetNull)
  iconFile    StoredFile? @relation("TenantBrandingIcon", fields: [iconFileId], references: [id], onDelete: SetNull)

  @@map("tenant_branding")
}

/// Identidade visual global Economização (singleton lógico). Ausência = Theme Default (ADR-049).
model PlatformBranding {
  id            String      @id @default(uuid()) @db.Uuid
  /// Discriminador único: sempre "default". Impede múltiplos registros ativos.
  singletonKey  String      @default("default") @map("singleton_key")
  name          String
  lightColors   Json?       @map("light_colors")
  darkColors    Json?       @map("dark_colors")
  logoFileId    String?     @unique @map("logo_file_id") @db.Uuid
  iconFileId    String?     @unique @map("icon_file_id") @db.Uuid
  faviconFileId String?     @unique @map("favicon_file_id") @db.Uuid
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  logoFile      StoredFile? @relation("PlatformBrandingLogo", fields: [logoFileId], references: [id], onDelete: SetNull)
  iconFile      StoredFile? @relation("PlatformBrandingIcon", fields: [iconFileId], references: [id], onDelete: SetNull)
  faviconFile   StoredFile? @relation("PlatformBrandingFavicon", fields: [faviconFileId], references: [id], onDelete: SetNull)

  @@unique([singletonKey], map: "uq_platform_branding_singleton")
  @@map("platform_branding")
}

enum StoredFileType {
  TENANT_LOGO
  TENANT_ICON
  PLATFORM_LOGO
  PLATFORM_ICON
  PLATFORM_FAVICON

  @@map("stored_file_type")
}

/// Arquivos gerenciados pela plataforma (docs/03 §4.3). Metadados + storage_key; bytes ficam no FileStorage.
/// tenantId null = asset global (PLATFORM_*); tenantId setado = asset do tenant (TENANT_*).
model StoredFile {
  id                      String            @id @default(uuid()) @db.Uuid
  tenantId                String?           @map("tenant_id") @db.Uuid
  fileType                StoredFileType    @map("file_type")
  storageKey              String            @unique(map: "uq_files_storage_key") @map("storage_key")
  mimeType                String            @map("mime_type")
  size                    Int
  checksum                String
  createdAt               DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  tenant                  Tenant?           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  brandingLogo            TenantBranding?   @relation("TenantBrandingLogo")
  brandingIcon            TenantBranding?   @relation("TenantBrandingIcon")
  platformBrandingLogo    PlatformBranding? @relation("PlatformBrandingLogo")
  platformBrandingIcon    PlatformBranding? @relation("PlatformBrandingIcon")
  platformBrandingFavicon PlatformBranding? @relation("PlatformBrandingFavicon")

  @@index([tenantId], map: "idx_files_tenant_id")
  @@map("files")
}

model User {
  id                     String          @id @default(uuid()) @db.Uuid
  tenantId               String?         @map("tenant_id") @db.Uuid
  name                   String
  email                  String          @unique(map: "uq_users_email")
  status                 UserStatus
  role                   UserRole
  lastLoginAt            DateTime?       @map("last_login_at") @db.Timestamptz(3)
  failedLoginAttempts    Int             @default(0) @map("failed_login_attempts")
  lockedUntil            DateTime?       @map("locked_until") @db.Timestamptz(3)
  passwordConfiguredAt   DateTime?       @map("password_configured_at") @db.Timestamptz(3)
  firstAccessCompletedAt DateTime?       @map("first_access_completed_at") @db.Timestamptz(3)
  createdAt              DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  deactivatedAt          DateTime?       @map("deactivated_at") @db.Timestamptz(3)
  tenant                 Tenant?         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  credential             UserCredential?
  supportSessions        SupportSession[] @relation("SupportSessionOperator")
  aiKnowledgeCreated     AiKnowledgeEntry[]
  aiConversations        AiConversation[]
  aiRuns                 AiRun[]

  @@index([tenantId], map: "idx_users_tenant_id")
  @@map("users")
}

/// Lifecycle privilegiado auditável de modo suporte (não é audit log genérico).
/// Índice único parcial `uq_support_sessions_open_redis_session` está na migration.
model SupportSession {
  id             String    @id @default(uuid()) @db.Uuid
  operatorUserId String    @map("operator_user_id") @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  startedAt      DateTime  @map("started_at") @db.Timestamptz(3)
  endedAt        DateTime? @map("ended_at") @db.Timestamptz(3)
  redisSessionId String?   @map("redis_session_id")
  ip             String?
  userAgent      String?   @map("user_agent")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  operator       User      @relation("SupportSessionOperator", fields: [operatorUserId], references: [id], onDelete: Restrict)
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([operatorUserId], map: "idx_support_sessions_operator_user_id")
  @@index([tenantId, startedAt], map: "idx_support_sessions_tenant_started_at")
  @@index([redisSessionId], map: "idx_support_sessions_redis_session_id")
  @@map("support_sessions")
}

enum IntegrationProvider {
  CONTA_AZUL

  @@map("integration_provider")
}

enum IntegrationStatus {
  DISCONNECTED
  CONNECTED
  ERROR

  @@map("integration_status")
}

/// Conexão de um tenant com um provedor externo. MVP: 1 Conta Azul por empresa.
model Integration {
  id                    String                      @id @default(uuid()) @db.Uuid
  tenantId              String                      @map("tenant_id") @db.Uuid
  provider              IntegrationProvider
  status                IntegrationStatus
  connectedAt           DateTime?                   @map("connected_at") @db.Timestamptz(3)
  disconnectedAt        DateTime?                   @map("disconnected_at") @db.Timestamptz(3)
  lastSuccessfulSyncAt  DateTime?                   @map("last_successful_sync_at") @db.Timestamptz(3)
  lastErrorAt           DateTime?                   @map("last_error_at") @db.Timestamptz(3)
  lastErrorCode         String?                     @map("last_error_code")
  createdAt             DateTime                    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant                Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  credential            IntegrationCredential?
  externalAccount       IntegrationExternalAccount?
  financialCategories   FinancialCategory[]
  financialAccounts     FinancialAccount[]
  parties               Party[]
  receivables           Receivable[]
  payables              Payable[]
  costCenters           CostCenter[]
  financialTransactions FinancialTransaction[]
  financialTransfers    FinancialTransfer[]
  financialAccountBalanceSnapshots FinancialAccountBalanceSnapshot[]
  financialInstallmentLifecycleCheckpoints FinancialInstallmentLifecycleCheckpoint[]
  installmentPresenceCheckpoints InstallmentPresenceCheckpoint[]
  syncRuns              SyncRun[]
  syncCursors           IntegrationSyncCursor[]

  @@unique([tenantId, provider], map: "uq_integrations_tenant_provider")
  @@index([tenantId], map: "idx_integrations_tenant_id")
  @@map("integrations")
}

/// Tokens OAuth cifrados (AES-256-GCM). Nunca plaintext. 1:1 com Integration.
model IntegrationCredential {
  id                    String      @id @default(uuid()) @db.Uuid
  integrationId         String      @unique(map: "uq_integration_credentials_integration_id") @map("integration_id") @db.Uuid
  encryptedAccessToken  String      @map("encrypted_access_token")
  encryptedRefreshToken String      @map("encrypted_refresh_token")
  accessExpiresAt       DateTime    @map("access_expires_at") @db.Timestamptz(3)
  tokenType             String      @map("token_type")
  createdAt             DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  integration           Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@map("integration_credentials")
}

/// Identidade da conta externa conectada (ex.: id_empresa Conta Azul). Subordinada à Integration.
/// Isolamento: queries sempre via Integration/Tenant — nunca só por externalAccountId.
model IntegrationExternalAccount {
  id                  String      @id @default(uuid()) @db.Uuid
  integrationId       String      @unique(map: "uq_integration_external_accounts_integration_id") @map("integration_id") @db.Uuid
  externalAccountId   String      @map("external_account_id")
  externalCompanyName String?     @map("external_company_name")
  /// Mínimo: documento, nomeFantasia, email. Nunca tokens nem resposta HTTP crua.
  metadata            Json?
  createdAt           DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  integration         Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@index([externalAccountId], map: "idx_integration_external_accounts_external_account_id")
  @@map("integration_external_accounts")
}

enum FinancialCategoryType {
  REVENUE
  EXPENSE
  UNKNOWN

  @@map("financial_category_type")
}

enum PartyProfile {
  CUSTOMER
  SUPPLIER
  CARRIER

  @@map("party_profile")
}

enum FinancialInstallmentStatus {
  OPEN
  OVERDUE
  PAID
  PARTIALLY_PAID
  LOST
  RENEGOTIATED
  UNKNOWN

  @@map("financial_installment_status")
}

/// Estado do enriquecimento de centro de custo por parcela (CC1.2).
/// Distingue UNKNOWN (nunca tentou) de NO_ALLOCATION (confirmado sem rateio).
enum CostCenterDetailStatus {
  UNKNOWN
  FETCHED
  NO_ALLOCATION
  UNRESOLVED
  ERROR

  @@map("cost_center_detail_status")
}

enum FinancialTransactionType {
  RECEIPT
  DISBURSEMENT

  @@map("financial_transaction_type")
}

/// Tombstone estrutural. Automação DESLIGADA até existir payload real de estorno.
enum FinancialTransactionLifecycle {
  ACTIVE
  DELETED

  @@map("financial_transaction_lifecycle")
}

/// Correção 11-E.1: lifecycle de presença upstream de parcelas AR/AP.
/// Ortogonal ao FinancialInstallmentStatus (estado financeiro).
enum InstallmentPresenceLifecycle {
  ACTIVE
  DELETED

  @@map("installment_presence_lifecycle")
}

enum FinancialTransactionInstallmentKind {
  RECEIVABLE
  PAYABLE

  @@map("financial_transaction_installment_kind")
}

/// Projeção conservadora transferência ↔ settlement. Nunca lifecycle.
enum FinancialTransferMatchStatus {
  UNMATCHED
  MATCHED
  AMBIGUOUS

  @@map("financial_transfer_match_status")
}

enum SyncRunTriggerType {
  MANUAL
  SCHEDULED

  @@map("sync_run_trigger_type")
}

enum IntegrationSyncCursorResource {
  PEOPLE
  RECEIVABLES
  PAYABLES

  @@map("integration_sync_cursor_resource")
}

enum SyncRunStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED

  @@map("sync_run_status")
}

/// Categoria financeira sincronizada da Conta Azul. Sem payload cru.
/// Lifecycle (11-C): active por presença no snapshot completo GET /v1/categorias
/// (permite_apenas_filhos=false). Sem hard-delete; reativação se reaparecer.
model FinancialCategory {
  id              String                 @id @default(uuid()) @db.Uuid
  tenantId        String                 @map("tenant_id") @db.Uuid
  integrationId   String                 @map("integration_id") @db.Uuid
  externalId      String                 @map("external_id")
  name            String
  type            FinancialCategoryType
  parentExternalId String?               @map("parent_external_id")
  upstreamVersion Int?                   @map("upstream_version")
  /// Presente no último snapshot completo da integration (=true); ausente (=false).
  active          Boolean                @default(true)
  syncedAt        DateTime               @map("synced_at") @db.Timestamptz(3)
  createdAt       DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant          Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  integration     Integration            @relation(fields: [integrationId], references: [id], onDelete: Restrict)

  @@unique([integrationId, externalId], map: "uq_financial_categories_integration_external_id")
  @@index([tenantId], map: "idx_financial_categories_tenant_id")
  @@index([tenantId, type], map: "idx_financial_categories_tenant_type")
  @@index([tenantId, active], map: "idx_financial_categories_tenant_active")
  @@map("financial_categories")
}

/// Conta financeira sincronizada. Sem agência, número ou dados bancários.
model FinancialAccount {
  id            String      @id @default(uuid()) @db.Uuid
  tenantId      String      @map("tenant_id") @db.Uuid
  integrationId String      @map("integration_id") @db.Uuid
  externalId    String      @map("external_id")
  name          String
  type          String
  active        Boolean
  syncedAt      DateTime    @map("synced_at") @db.Timestamptz(3)
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  integration   Integration @relation(fields: [integrationId], references: [id], onDelete: Restrict)
  balanceSnapshots FinancialAccountBalanceSnapshot[]

  @@unique([integrationId, externalId], map: "uq_financial_accounts_integration_external_id")
  @@index([tenantId], map: "idx_financial_accounts_tenant_id")
  @@map("financial_accounts")
}

/// Snapshot diário de saldo oficial Conta Azul (saldo-atual). Um ponto por conta/dia civil SP.
/// Não reconstruído pelo ledger. Histórico inativo permanece.
model FinancialAccountBalanceSnapshot {
  id                         String           @id @default(uuid()) @db.Uuid
  tenantId                   String           @map("tenant_id") @db.Uuid
  integrationId              String           @map("integration_id") @db.Uuid
  financialAccountId         String           @map("financial_account_id") @db.Uuid
  financialAccountExternalId String           @map("financial_account_external_id")
  balance                    Decimal          @db.Decimal(19, 4)
  /// Dia civil America/Sao_Paulo (meia-noite UTC).
  balanceDate                DateTime         @map("balance_date") @db.Date
  capturedAt                 DateTime         @map("captured_at") @db.Timestamptz(3)
  /// active no momento da captura (histórico; active atual da conta pode mudar).
  accountActiveAtCapture     Boolean          @map("account_active_at_capture")
  createdAt                  DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                  DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant                     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  integration                Integration      @relation(fields: [integrationId], references: [id], onDelete: Restrict)
  financialAccount           FinancialAccount @relation(fields: [financialAccountId], references: [id], onDelete: Restrict)

  @@unique([financialAccountId, balanceDate], map: "uq_financial_account_balance_snapshots_account_date")
  @@index([tenantId, balanceDate], map: "idx_financial_account_balance_snapshots_tenant_date")
  @@index([tenantId, financialAccountId, balanceDate], map: "idx_financial_account_balance_snapshots_tenant_account_date")
  @@map("financial_account_balance_snapshots")
}

/// Pessoa do ERP (cliente e/ou fornecedor). Uma linha por externalId.
model Party {
  id            String        @id @default(uuid()) @db.Uuid
  tenantId      String        @map("tenant_id") @db.Uuid
  integrationId String        @map("integration_id") @db.Uuid
  externalId    String        @map("external_id")
  name          String
  document      String?
  active        Boolean
  profiles      PartyProfile[]
  syncedAt      DateTime      @map("synced_at") @db.Timestamptz(3)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  integration   Integration   @relation(fields: [integrationId], references: [id], onDelete: Restrict)
  receivables   Receivable[]  @relation("ReceivableParty")
  payables      Payable[]     @relation("PayableParty")

  @@unique([integrationId, externalId], map: "uq_parties_integration_external_id")
  @@index([tenantId], map: "idx_parties_tenant_id")
  @@map("parties")
}

/// Parcela a receber. Categorias: só external IDs (cadastro próprio já existe).
model Receivable {
  id                 String                      @id @default(uuid()) @db.Uuid
  tenantId           String                      @map("tenant_id") @db.Uuid
  integrationId      String                      @map("integration_id") @db.Uuid
  externalId         String                      @map("external_id")
  description        String?
  dueDate            DateTime                    @map("due_date") @db.Date
  competenceDate     DateTime?                   @map("competence_date") @db.Date
  upstreamCreatedAt  DateTime?                   @map("upstream_created_at") @db.Timestamptz(3)
  upstreamUpdatedAt  DateTime?                   @map("upstream_updated_at") @db.Timestamptz(3)
  status             FinancialInstallmentStatus
  upstreamStatus     String?                     @map("upstream_status")
  total              Decimal                     @db.Decimal(19, 4)
  paid               Decimal                     @db.Decimal(19, 4)
  unpaid             Decimal                     @db.Decimal(19, 4)
  externalCustomerId String?                     @map("external_customer_id")
  partyId            String?                     @map("party_id") @db.Uuid
  categoryExternalIds String[]                   @map("category_external_ids")
  /// CC1.2 — último resultado do GET /parcelas/{id} para rateio de centro.
  costCenterDetailStatus CostCenterDetailStatus @default(UNKNOWN) @map("cost_center_detail_status")
  costCenterDetailSyncedAt DateTime? @map("cost_center_detail_synced_at") @db.Timestamptz(3)
  costCenterDetailRuleVersion Int @default(0) @map("cost_center_detail_rule_version")
  /// 11-E.1: presença upstream. Ortogonal ao status financeiro.
  lifecycleStatus    InstallmentPresenceLifecycle @default(ACTIVE) @map("lifecycle_status")
  lifecycleDeletedAt DateTime?                   @map("lifecycle_deleted_at") @db.Timestamptz(3)
  syncedAt           DateTime                    @map("synced_at") @db.Timestamptz(3)
  createdAt          DateTime                    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant             Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  integration        Integration                 @relation(fields: [integrationId], references: [id], onDelete: Restrict)
  party              Party?                      @relation("ReceivableParty", fields: [partyId], references: [id], onDelete: SetNull)
  costCenterAllocations InstallmentCostCenterAllocation[]

  @@unique([integrationId, externalId], map: "uq_receivables_integration_external_id")
  @@index([tenantId], map: "idx_receivables_tenant_id")
  @@index([tenantId, dueDate], map: "idx_receivables_tenant_due_date")
  @@index([tenantId, status], map: "idx_receivables_tenant_status")
  @@index([tenantId, costCenterDetailStatus], map: "idx_receivables_tenant_cc_detail_status")
  @@index([tenantId, lifecycleStatus, status], map: "idx_receivables_tenant_lifecycle_status")
  @@index([tenantId, lifecycleStatus, dueDate], map: "idx_receivables_tenant_lifecycle_due_date")
  @@map("receivables")
}

/// Parcela a pagar. Soft-tombstone de presença (11-E.1); sem hard-delete.
model Payable {
  id                 String                      @id @default(uuid()) @db.Uuid
  tenantId           String                      @map("tenant_id") @db.Uuid
  integrationId      String                      @map("integration_id") @db.Uuid
  externalId         String                      @map("external_id")
  description        String?
  dueDate            DateTime                    @map("due_date") @db.Date
  competenceDate     DateTime?                   @map("competence_date") @db.Date
  upstreamCreatedAt  DateTime?                   @map("upstream_created_at") @db.Timestamptz(3)
  upstreamUpdatedAt  DateTime?                   @map("upstream_updated_at") @db.Timestamptz(3)
  status             FinancialInstallmentStatus
  upstreamStatus     String?                     @map("upstream_status")
  total              Decimal                     @db.Decimal(19, 4)
  paid               Decimal                     @db.Decimal(19, 4)
  unpaid             Decimal                     @db.Decimal(19, 4)
  externalSupplierId String?                     @map("external_supplier_id")
  partyId            String?                     @map("party_id") @db.Uuid
  categoryExternalIds String[]                   @map("category_external_ids")
  /// CC1.2 — último resultado do GET /parcelas/{id} para rateio de centro.
  costCenterDetailStatus CostCenterDetailStatus @default(UNKNOWN) @map("cost_center_detail_status")
  costCenterDetailSyncedAt DateTime? @map("cost_center_detail_synced_at") @db.Timestamptz(3)
  costCenterDetailRuleVersion Int @default(0) @map("cost_center_detail_rule_version")
  /// 11-E.1: presença upstream. Ortogonal ao status financeiro.
  lifecycleStatus    InstallmentPresenceLifecycle @default(ACTIVE) @map("lifecycle_status")
  lifecycleDeletedAt DateTime?                   @map("lifecycle_deleted_at") @db.Timestamptz(3)
  syncedAt           DateTime                    @map("synced_at") @db.Timestamptz(3)
  createdAt          DateTime                    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant             Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  integration        Integration                 @relation(fields: [integrationId], references: [id], onDelete: Restrict)
  party              Party?                      @relation("PayableParty", fields: [partyId], references: [id], onDelete: SetNull)
  costCenterAllocations InstallmentCostCenterAllocation[]

  @@unique([integrationId, externalId], map: "uq_payables_integration_external_id")
  @@index([tenantId], map: "idx_payables_tenant_id")
  @@index([tenantId, dueDate], map: "idx_payables_tenant_due_date")
  @@index([tenantId, status], map: "idx_payables_tenant_status")
  @@index([tenantId, costCenterDetailStatus], map: "idx_payables_tenant_cc_detail_status")
  @@index([tenantId, lifecycleStatus, status], map: "idx_payables_tenant_lifecycle_status")
  @@index([tenantId, lifecycleStatus, dueDate], map: "idx_payables_tenant_lifecycle_due_date")
  @@map("payables")
}


/// Catálogo de centros de custo Conta Azul (CC1).
model CostCenter {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  integrationId String   @map("integration_id") @db.Uuid
  externalId    String   @map("external_id")
  code          String?
  name          String
  active        Boolean  @default(true)
  syncedAt      DateTime @map("synced_at") @db.Timestamptz(3)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant        Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  integration   Integration @relation(fields: [integrationId], references: [id], onDelete: Restrict)
  allocations   InstallmentCostCenterAllocation[]

  @@unique([integrationId, externalId], map: "uq_cost_centers_integration_external_id")
  @@index([tenantId, active], map: "idx_cost_centers_tenant_active")
  @@index([tenantId, name], map: "idx_cost_centers_tenant_name")
  @@map("cost_centers")
}

/// Alocação monetária parcela↔centro (valor oficial do rateio Conta Azul).
model InstallmentCostCenterAllocation {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  costCenterId String   @map("cost_center_id") @db.Uuid
  receivableId String?  @map("receivable_id") @db.Uuid
  payableId    String?  @map("payable_id") @db.Uuid
  amount       Decimal  @db.Decimal(19, 4)
  syncedAt     DateTime @map("synced_at") @db.Timestamptz(3)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant       Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  costCenter   CostCenter @relation(fields: [costCenterId], references: [id], onDelete: Restrict)
  receivable   Receivable? @relation(fields: [receivableId], references: [id], onDelete: Cascade)
  payable      Payable? @relation(fields: [payableId], references: [id], onDelete: Cascade)

  @@index([tenantId, costCenterId], map: "idx_icca_tenant_cost_center")
  @@index([receivableId], map: "idx_icca_receivable")
  @@index([payableId], map: "idx_icca_payable")
  @@map("installment_cost_center_allocations")
}

/// Meta mensal de faturamento gerencial por tenant (F2).
/// `actual` NÃO é persistido — calculado via monthly-revenue / competência.
model RevenueGoal {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  monthKey     String   @map("month_key") @db.VarChar(7)
  targetAmount Decimal  @map("target_amount") @db.Decimal(19, 4)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, monthKey], map: "uq_revenue_goals_tenant_month")
  @@index([tenantId, monthKey], map: "idx_revenue_goals_tenant_month")
  @@map("revenue_goals")
}

/// Uma linha = uma baixa Conta Azul (CASH-2). Sem FK para AR/AP.
/// grossAmount = quitação do título; netAmount = caixa oficial futuro.
model FinancialTransaction {
  id                         String                              @id @default(uuid()) @db.Uuid
  tenantId                   String                              @map("tenant_id") @db.Uuid
  integrationId              String                              @map("integration_id") @db.Uuid
  externalId                 String                              @map("external_id")
  installmentExternalId      String                              @map("installment_external_id")
  installmentKind            FinancialTransactionInstallmentKind @map("installment_kind")
  transactionType            FinancialTransactionType            @map("transaction_type")
  occurredOn                 DateTime                            @map("occurred_on") @db.Date
  grossAmount                Decimal                             @map("gross_amount") @db.Decimal(19, 4)
  netAmount                  Decimal                             @map("net_amount") @db.Decimal(19, 4)
  interestAmount             Decimal                             @map("interest_amount") @db.Decimal(19, 4)
  fineAmount                 Decimal                             @map("fine_amount") @db.Decimal(19, 4)
  discountAmount             Decimal                             @map("discount_amount") @db.Decimal(19, 4)
  feeAmount                  Decimal                             @map("fee_amount") @db.Decimal(19, 4)
  financialAccountExternalId String?                             @map("financial_account_external_id")
  paymentMethod              String?                             @map("payment_method")
  upstreamVersion            Int?                                @map("upstream_version")
  upstreamUpdatedAt          DateTime?                           @map("upstream_updated_at") @db.Timestamptz(3)
  lifecycleStatus            FinancialTransactionLifecycle       @map("lifecycle_status")
  financialTransferId        String?                             @unique(map: "uq_financial_transactions_financial_transfer_id") @map("financial_transfer_id") @db.Uuid
  syncedAt                   DateTime                            @map("synced_at") @db.Timestamptz(3)
  createdAt                  DateTime                            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                  DateTime                            @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant                     Tenant                              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  integration                Integration                         @relation(fields: [integrationId], references: [id], onDelete: Restrict)
  financialTransfer          FinancialTransfer?                  @relation(fields: [financialTransferId], references: [id], onDelete: SetNull)

  @@unique([integrationId, externalId], map: "uq_financial_transactions_integration_external_id")
  @@index([tenantId], map: "idx_financial_transactions_tenant_id")
  @@index([tenantId, occurredOn], map: "idx_financial_transactions_tenant_occurred_on")
  @@index([tenantId, installmentExternalId], map: "idx_financial_transactions_tenant_installment")
  @@index([tenantId, transactionType, occurredOn], map: "idx_financial_transactions_tenant_type_occurred_on")
  @@map("financial_transactions")
}

/// Correção 10-F: watermark de probe de lifecycle por parcela (discovery bounded).
/// Ausência de row = nunca verificado. NÃO é evidência de tombstone.
model FinancialInstallmentLifecycleCheckpoint {
  id                     String                              @id @default(uuid()) @db.Uuid
  tenantId               String                              @map("tenant_id") @db.Uuid
  integrationId          String                              @map("integration_id") @db.Uuid
  installmentKind        FinancialTransactionInstallmentKind @map("installment_kind")
  installmentExternalId  String                              @map("installment_external_id")
  lastLifecycleCheckedAt DateTime                            @map("last_lifecycle_checked_at") @db.Timestamptz(3)
  createdAt              DateTime                            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime                            @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant                 Tenant                              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  integration            Integration                         @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@unique([integrationId, installmentKind, installmentExternalId], map: "uq_filc_integration_kind_installment")
  @@index([tenantId], map: "idx_filc_tenant_id")
  @@index([integrationId, lastLifecycleCheckedAt], map: "idx_filc_integration_checked_at")
  @@map("financial_installment_lifecycle_checkpoints")
}

/// Correção 11-E.1: watermark de probe de presença AR/AP (manutenção bounded).
/// Ausência de row = nunca verificado. NÃO é evidência de tombstone.
model InstallmentPresenceCheckpoint {
  id                      String                              @id @default(uuid()) @db.Uuid
  tenantId                String                              @map("tenant_id") @db.Uuid
  integrationId           String                              @map("integration_id") @db.Uuid
  installmentKind         FinancialTransactionInstallmentKind @map("installment_kind")
  installmentExternalId   String                              @map("installment_external_id")
  lastPresenceCheckedAt   DateTime                            @map("last_presence_checked_at") @db.Timestamptz(3)
  createdAt               DateTime                            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime                            @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant                  Tenant                              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  integration             Integration                         @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@unique([integrationId, installmentKind, installmentExternalId], map: "uq_ipc_integration_kind_installment")
  @@index([tenantId], map: "idx_ipc_tenant_id")
  @@index([integrationId, lastPresenceCheckedAt], map: "idx_ipc_integration_checked_at")
  @@map("installment_presence_checkpoints")
}

/// CASH-9C: um objeto origem/destino = uma transferência entre contas próprias.
/// Não é RECEIPT/DISBURSEMENT. Não entra em faturamento/despesas/resultado.
model FinancialTransfer {
  id                                       String                       @id @default(uuid()) @db.Uuid
  tenantId                                 String                       @map("tenant_id") @db.Uuid
  integrationId                            String                       @map("integration_id") @db.Uuid
  externalId                               String                       @map("external_id")
  occurredOn                               DateTime                     @map("occurred_on") @db.Date
  amount                                   Decimal                      @db.Decimal(19, 4)
  sourceFinancialAccountExternalId         String                       @map("source_financial_account_external_id")
  destinationFinancialAccountExternalId    String                       @map("destination_financial_account_external_id")
  description                              String?
  matchStatus                              FinancialTransferMatchStatus @map("match_status")
  syncedAt                                 DateTime                     @map("synced_at") @db.Timestamptz(3)
  createdAt                                DateTime                     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                                DateTime                     @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant                                   Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  integration                              Integration                  @relation(fields: [integrationId], references: [id], onDelete: Restrict)
  projectedTransaction                     FinancialTransaction?

  @@unique([integrationId, externalId], map: "uq_financial_transfers_integration_external_id")
  @@index([tenantId], map: "idx_financial_transfers_tenant_id")
  @@index([tenantId, occurredOn], map: "idx_financial_transfers_tenant_occurred_on")
  @@index([tenantId, sourceFinancialAccountExternalId], map: "idx_financial_transfers_tenant_source_account")
  @@index([tenantId, destinationFinancialAccountExternalId], map: "idx_financial_transfers_tenant_destination_account")
  @@map("financial_transfers")
}

/// Execução técnica da sync (2.3 manual / 2.4 scheduled). Não é o produto de histórico da 2.5.
/// Índice único parcial RUNNING/PENDING: ver migration SQL.
model SyncRun {
  id            String              @id @default(uuid()) @db.Uuid
  tenantId      String              @map("tenant_id") @db.Uuid
  integrationId String              @map("integration_id") @db.Uuid
  triggerType   SyncRunTriggerType  @map("trigger_type")
  status        SyncRunStatus
  startedAt     DateTime            @map("started_at") @db.Timestamptz(3)
  finishedAt    DateTime?           @map("finished_at") @db.Timestamptz(3)
  heartbeatAt   DateTime?           @map("heartbeat_at") @db.Timestamptz(3)
  errorCode     String?             @map("error_code")
  counts        Json?
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  integration   Integration         @relation(fields: [integrationId], references: [id], onDelete: Restrict)
  syncCursors   IntegrationSyncCursor[]

  @@index([tenantId], map: "idx_sync_runs_tenant_id")
  @@index([integrationId, startedAt], map: "idx_sync_runs_integration_started_at")
  @@map("sync_runs")
}

/// Watermark incremental por recurso (2.4). cursorAt = limite superior da janela processada.
/// Categorias e contas financeiras não usam cursor (full barato a cada ciclo).
model IntegrationSyncCursor {
  id                 String                         @id @default(uuid()) @db.Uuid
  tenantId           String                         @map("tenant_id") @db.Uuid
  integrationId      String                         @map("integration_id") @db.Uuid
  resource           IntegrationSyncCursorResource
  cursorAt           DateTime                       @map("cursor_at") @db.Timestamptz(3)
  externalAccountId  String                         @map("external_account_id")
  lastRunId          String?                        @map("last_run_id") @db.Uuid
  createdAt          DateTime                       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime                       @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant             Tenant                         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  integration        Integration                    @relation(fields: [integrationId], references: [id], onDelete: Restrict)
  lastRun            SyncRun?                       @relation(fields: [lastRunId], references: [id], onDelete: SetNull)

  @@unique([integrationId, resource], map: "uq_integration_sync_cursors_integration_resource")
  @@index([tenantId], map: "idx_integration_sync_cursors_tenant_id")
  @@map("integration_sync_cursors")
}

/// Credencial de senha 1:1. Usuário PENDING pode existir sem registro.
model UserCredential {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @unique(map: "uq_user_credentials_user_id") @map("user_id") @db.Uuid
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_credentials")
}

enum AiProvider {
  OPENAI
  ANTHROPIC

  @@map("ai_provider")
}

enum AiConsultantStatus {
  ACTIVE
  DISABLED

  @@map("ai_consultant_status")
}

enum AiTonePreset {
  PROFISSIONAL_OBJETIVO
  CONSULTIVO
  DIDATICO
  AMIGAVEL
  EXECUTIVO
  PERSONALIZADO

  @@map("ai_tone_preset")
}

enum AiKnowledgeContentType {
  TEXT

  @@map("ai_knowledge_content_type")
}

enum AiKnowledgeStatus {
  ACTIVE
  DISABLED

  @@map("ai_knowledge_status")
}

enum AiConversationStatus {
  OPEN
  CLOSED

  @@map("ai_conversation_status")
}

enum AiMessageSenderType {
  USER
  CONSULTANT
  SYSTEM

  @@map("ai_message_sender_type")
}

enum AiMessageType {
  TEXT

  @@map("ai_message_type")
}

enum AiRunType {
  QUESTION_REPLY

  @@map("ai_run_type")
}

enum AiRunStatus {
  STARTED
  SUCCEEDED
  FAILED
  TIMEOUT
  LIMIT_BLOCKED

  @@map("ai_run_status")
}

enum AiRunErrorCode {
  AUTH
  RATE_LIMIT
  TIMEOUT
  MODEL_UNAVAILABLE
  BAD_REQUEST
  CONTENT_REJECTED
  PROVIDER_ERROR
  UNKNOWN

  @@map("ai_run_error_code")
}

/// Credencial global de plataforma (OpenAI/Anthropic). Uma chave por provider.
/// Ciphertext AES-256-GCM (secret-box). Sem plaintext. Não pertence a tenant.
model AiPlatformCredential {
  id              String     @id @default(uuid()) @db.Uuid
  provider        AiProvider @unique(map: "uq_ai_platform_credentials_provider")
  encryptedSecret String     @map("encrypted_secret") @db.Text
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("ai_platform_credentials")
}

/// Configuração 1:1 do Consultor por tenant. Sem settings = não configurado/desabilitado.
/// Provider/model efetivos vêm daqui, não de env. Sem API key.
model AiTenantSettings {
  id                  String             @id @default(uuid()) @db.Uuid
  tenantId            String             @unique(map: "uq_ai_tenant_settings_tenant_id") @map("tenant_id") @db.Uuid
  provider            AiProvider
  model               String
  consultantName      String?            @map("consultant_name")
  businessSegment     String?            @map("business_segment")
  businessDescription String?            @map("business_description") @db.Text
  adminPrompt         String?            @map("admin_prompt") @db.Text
  tonePreset          AiTonePreset       @default(PROFISSIONAL_OBJETIVO) @map("tone_preset")
  tone                String?
  status              AiConsultantStatus @default(DISABLED)
  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant              Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@map("ai_tenant_settings")
}

/// Conhecimento textual exclusivo do tenant. Conteúdo não é interpolado na persistência.
model AiKnowledgeEntry {
  id          String                 @id @default(uuid()) @db.Uuid
  tenantId    String                 @map("tenant_id") @db.Uuid
  title       String
  content     String                 @db.Text
  contentType AiKnowledgeContentType @default(TEXT) @map("content_type")
  status      AiKnowledgeStatus      @default(DISABLED)
  createdById String                 @map("created_by") @db.Uuid
  createdAt   DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant      Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  createdBy   User                   @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([tenantId], map: "idx_ai_knowledge_entries_tenant_id")
  @@map("ai_knowledge_entries")
}

/// Conversa do Consultor: pertence ao tenant e ao usuário.
model AiConversation {
  id            String               @id @default(uuid()) @db.Uuid
  tenantId      String               @map("tenant_id") @db.Uuid
  userId        String               @map("user_id") @db.Uuid
  status        AiConversationStatus @default(OPEN)
  title         String?
  startedAt     DateTime             @map("started_at") @db.Timestamptz(3)
  lastMessageAt DateTime             @map("last_message_at") @db.Timestamptz(3)
  createdAt     DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant        Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user          User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  messages      AiMessage[]
  runs          AiRun[]

  @@index([tenantId], map: "idx_ai_conversations_tenant_id")
  @@index([tenantId, userId], map: "idx_ai_conversations_tenant_user")
  @@index([tenantId, lastMessageAt], map: "idx_ai_conversations_tenant_last_message_at")
  @@map("ai_conversations")
}

/// Mensagem de uma conversa. Sem related_insight_id (F14).
model AiMessage {
  id             String              @id @default(uuid()) @db.Uuid
  conversationId String              @map("conversation_id") @db.Uuid
  tenantId       String              @map("tenant_id") @db.Uuid
  senderType     AiMessageSenderType @map("sender_type")
  content        String              @db.Text
  messageType    AiMessageType       @default(TEXT) @map("message_type")
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  conversation   AiConversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  tenant         Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  runs           AiRun[]

  @@index([tenantId], map: "idx_ai_messages_tenant_id")
  @@index([conversationId, createdAt], map: "idx_ai_messages_conversation_created_at")
  @@map("ai_messages")
}

/// Auditoria de execução do provedor. Sem API key, prompt financeiro, body/headers do vendor.
model AiRun {
  id             String          @id @default(uuid()) @db.Uuid
  tenantId       String          @map("tenant_id") @db.Uuid
  userId         String?         @map("user_id") @db.Uuid
  conversationId String?         @map("conversation_id") @db.Uuid
  messageId      String?         @map("message_id") @db.Uuid
  runType        AiRunType       @default(QUESTION_REPLY) @map("run_type")
  provider       AiProvider
  model          String
  status         AiRunStatus
  inputTokens    Int?            @map("input_tokens")
  outputTokens   Int?            @map("output_tokens")
  durationMs     Int?            @map("duration_ms")
  errorCode      AiRunErrorCode? @map("error_code")
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  finishedAt     DateTime?       @map("finished_at") @db.Timestamptz(3)
  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user           User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  conversation   AiConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  message        AiMessage?      @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt], map: "idx_ai_runs_tenant_created_at")
  @@map("ai_runs")
}
