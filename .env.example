# Environment
APP_ENV=<environment>

# Frontend
NEXT_PUBLIC_APP_URL=<frontend-url>

# Backend
API_URL=<backend-url>
API_PORT=<backend-port>

# PostgreSQL
POSTGRES_DB=<postgresql-database>
POSTGRES_USER=<postgresql-user>
POSTGRES_PASSWORD=<postgresql-password>
POSTGRES_PORT=<postgresql-host-port>
DATABASE_URL=postgresql://<postgresql-user>:<postgresql-password>@127.0.0.1:<postgresql-host-port>/<postgresql-database>

# Redis
REDIS_URL=<redis-connection-url>

# Authentication
# Minimum 32 characters. Used to sign session cookies (@fastify/session).
AUTH_SECRET=<authentication-secret-min-32-characters>

# Conta Azul
CONTA_AZUL_CLIENT_ID=<conta-azul-client-id>
CONTA_AZUL_CLIENT_SECRET=<conta-azul-client-secret>
CONTA_AZUL_REDIRECT_URI=<conta-azul-redirect-uri>

# Artificial intelligence
AI_PROVIDER=<ai-provider>
AI_API_KEY=<ai-api-key>

# Storage
STORAGE_PROVIDER=<storage-provider>
STORAGE_PATH=<storage-path>

# Application URLs and domain
APP_URL=<application-url>
APP_DOMAIN=<application-domain>

# Logs
LOG_LEVEL=<log-level>
