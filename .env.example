# Environment
APP_ENV=<environment>
NODE_ENV=development
HOST=127.0.0.1
PORT=3001

# Frontend / Next (produção: /etc/dashboard-economizacao/web.env)
# O processo Next NÃO lê o .env da raiz automaticamente.
NEXT_PUBLIC_APP_URL=<frontend-url>
API_URL=http://127.0.0.1:3001

# Backend (API usa PORT, não API_PORT)
API_PORT=<legacy-unused-use-PORT>

# PostgreSQL
POSTGRES_DB=<postgresql-database>
POSTGRES_USER=<postgresql-user>
POSTGRES_PASSWORD=<postgresql-password>
POSTGRES_PORT=<postgresql-host-port>
DATABASE_URL=postgresql://<postgresql-user>:<postgresql-password>@127.0.0.1:<postgresql-host-port>/<postgresql-database>
# Banco isolado usado exclusivamente pela suíte backend. O nome deve terminar em `_test`.
TEST_DATABASE_URL=postgresql://<postgresql-user>:<postgresql-password>@127.0.0.1:<postgresql-host-port>/<postgresql-test-database>_test

# Redis
REDIS_PORT=<redis-host-port>
REDIS_URL=redis://127.0.0.1:<redis-host-port>

# Authentication
# Minimum 32 characters. Used to sign session cookies (@fastify/session).
AUTH_SECRET=<authentication-secret-min-32-characters>

# Conta Azul (OAuth 2.0 Authorization Code — credenciais da APLICAÇÃO)
CONTA_AZUL_CLIENT_ID=<conta-azul-client-id>
CONTA_AZUL_CLIENT_SECRET=<conta-azul-client-secret>
# Deve ser a origem do frontend (rewrite same-origin), ex.: http://127.0.0.1:3000/integrations/conta-azul/callback
CONTA_AZUL_REDIRECT_URI=<conta-azul-redirect-uri>
# Intervalo da sync automática em minutos (inteiro, mínimo 5, default 60).
CONTA_AZUL_AUTO_SYNC_INTERVAL_MINUTES=60

# Cifração AES-256-GCM dos tokens por tenant. 64 hex (32 bytes). Nunca no banco.
# Gerar: openssl rand -hex 32
INTEGRATION_ENCRYPTION_KEY=<64-hex-chars>

# Artificial intelligence (credenciais da PLATAFORMA — nunca no banco, nunca no frontend)
# Ausência não impede build, migration, testes sem rede nem boot.
# Provider efetivo da execução vem de ai_tenant_settings.provider (por tenant).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Default apenas para criação/configuração nova. Não determina execução de tenant já configurado.
# Valores: OPENAI | ANTHROPIC
AI_PROVIDER=

# Storage
# MVP: filesystem local. Produção exige STORAGE_PATH explícito.
STORAGE_PROVIDER=local
STORAGE_PATH=<storage-path>
# Isolado para a suíte backend. O diretório deve terminar em `_test`.
TEST_STORAGE_PATH=<storage-path>_test

# Application URLs and domain
APP_URL=<application-url>
APP_DOMAIN=<application-domain>
# Apenas modo IP temporário HTTP do piloto (NODE_ENV=production + APP_URL http://).
# Ignorada quando APP_URL é https://. Default seguro: ausente/false.
ALLOW_INSECURE_HTTP_SESSION=false

# Logs
LOG_LEVEL=<log-level>
