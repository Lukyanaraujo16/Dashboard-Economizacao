[Unit]
Description=Dashboard Economização Web (Next.js)
After=network-online.target dashboard-economizacao-api.service
Wants=network-online.target

[Service]
Type=simple
User=__SERVICE_USER__
Group=__SERVICE_GROUP__
WorkingDirectory=__APP_HOME__/frontend
EnvironmentFile=__WEB_ENV_FILE__
Environment=NODE_ENV=production
ExecStart=__NODE_BIN__ node_modules/next/dist/bin/next start -H 127.0.0.1 -p 3000
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
