[Unit]
Description=Dashboard Economização Worker (BullMQ + scheduler)
After=network-online.target docker.service dashboard-economizacao-api.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
User=__SERVICE_USER__
Group=__SERVICE_GROUP__
WorkingDirectory=__APP_HOME__/backend
EnvironmentFile=__APP_ENV_FILE__
Environment=HOME=__SERVICE_HOME__
Environment=NODE_ENV=production
ExecStart=__NODE_BIN__ dist/worker.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=60
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
